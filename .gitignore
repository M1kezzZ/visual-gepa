# Project-specific
# Raw experiment outputs are local-only, EXCEPT for the small summary JSONs
# that the audit chain in visual-gepa-research/refine-logs/ cites. Those are
# tracked so the public code repo carries the canonical evidence pointer.
# Note: must be `results/*` (not `results/`) for the !exception to apply.
results/*
!results/B0_smoke.json
!results/B1_*.json
!results/B2_*.json
!results/B3_*.json
!results/B4_*.json
!results/B5_*.json
!results/B6_*.json
!results/B7_*.json
runs/
wandb/
*.log
models/                  # large checkpoints — store under ~/models/
cache/                   # CLIP embedding cache, trajectory cache
*.jsonl.gz
*.pkl
checkpoints/

# OSWorld / WebArena artifacts
osworld-data/
webarena-data/
screenshots/*.png
!screenshots/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
