# Copy to .env (gitignored) and fill in real values.
# NEVER commit .env.

# Anthropic API key (Claude Opus 4.7 vision = the reflection LM).
# Get from https://console.anthropic.com — note that Claude.ai Pro/Max subscription
# does NOT include API access; this is a separate billing entity.
ANTHROPIC_API_KEY=sk-ant-...

# Local vLLM endpoint for Qwen3.5-9B backbone (OpenAI-compatible, legacy path).
# Only used when --backbone-kind=vllm. Default backbone (2026-05-28+) is the
# OpenAI-compatible API below.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen3.5-9B

# OpenAI-compatible backbone (B2 proper full+ default).
# AnyAIGC proxy serves GPT-5.5 (78.7% OSWorld-Verified May 2026 leaderboard).
# Same anyaigc account as ANTHROPIC_API_KEY but a separate key with OpenAI-
# schema access. Costs ~6× cheaper than Claude on vision tokens at our scale.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://anyaigc.com/v1
OPENAI_MODEL=gpt-5.5

# SwanLab — experiment tracking (https://swanlab.cn). Auto-logs GPU/CPU/RAM.
# Get key from your swanlab account settings.
SWANLAB_API_KEY=...

# Optional: DashScope (Alibaba) if you don't want to self-host.
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_MODEL=qwen3.5-9b

# Optional: HuggingFace Inference Endpoints.
# HF_TOKEN=hf_...

# Optional: Weights & Biases logging.
# WANDB_API_KEY=...
# WANDB_PROJECT=visual-gepa
# WANDB_ENTITY=M1kezzZ
